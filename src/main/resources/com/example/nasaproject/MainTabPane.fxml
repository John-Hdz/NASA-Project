<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<TabPane fx:id="tabPane" style="-fx-background-color: #1a1a1c" xmlns="http://javafx.com/javafx/17.0.2-ea"
         xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.nasaproject.Controladores.funtions.MainTabPaneController">

    <Tab fx:id="TabHome" closable="false" text="             Home           ">
        <graphic>
            <ImageView fitHeight="50" preserveRatio="true">
                <Image url="@/NASA LOGO/NASA.png" />
            </ImageView>
        </graphic>
        <fx:include source="Home.fxml" />

    </Tab>
    <Tab fx:id="TabAPOD" closable="false" text=" APOD: Astronomy Picture of the Day">
        <graphic>
            <ImageView fitHeight="50" preserveRatio="true">
                <Image url="@/NASA LOGO/LOGO-APOD.png" />
            </ImageView>
        </graphic>
        <!--fx:include source="APOD.fxml"/-->


    </Tab>
    <Tab fx:id="TabLibrary" closable="false" text=" Nasa Image and Video Library">
        <graphic>
            <ImageView fitHeight="42" preserveRatio="true">
                <Image url="@/NASA LOGO/Nasa_Black.png" />
            </ImageView>
        </graphic>
        <!--fx:include source="Library.fxml"/-->

    </Tab>

    <Tab fx:id="TabEpic" closable="false" text=" EPIC: Earth Polychromatic Imaging Camera">
        <graphic>
            <ImageView fitHeight="45" preserveRatio="true">
                <Image url="@/NASA LOGO/Nasa_red.png" />
            </ImageView>
        </graphic>
        <!--fx:include source="Epic.fxml"/ -->

    </Tab>

</TabPane>
