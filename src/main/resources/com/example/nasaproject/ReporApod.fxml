<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.nasaproject.Controladores.funtions.ReporApodController"
      minWidth="1066" minHeight="650">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
  </padding>

  <Label text="APOD Downloads" style="-fx-font-size: 30"/>
  <TableView fx:id="tblApod">
    <columns>

      <TableColumn fx:id="tblColum1" text="Title" minWidth="100">
        <cellValueFactory>
          <PropertyValueFactory property="titulo" />
        </cellValueFactory>
      </TableColumn>

      <TableColumn fx:id="tblColum2" text="Description" minWidth="100">
        <cellValueFactory>
          <PropertyValueFactory property="descripcion" />
        </cellValueFactory>
      </TableColumn>

      <TableColumn fx:id="tblColum3" text="Type" minWidth="100">
        <cellValueFactory>
          <PropertyValueFactory property="tipo" />
        </cellValueFactory>
      </TableColumn>

      <TableColumn fx:id="tblColum4" text="Date" minWidth="100">
        <cellValueFactory>
          <PropertyValueFactory property="fecha" />
        </cellValueFactory>
      </TableColumn>

      <TableColumn fx:id="tblColum5" text="Url" minWidth="300">
        <cellValueFactory>
          <PropertyValueFactory property="url" />
        </cellValueFactory>
      </TableColumn>

    </columns>
  </TableView>
  <Button styleClass="btn, btn-success" onAction="#onReportButtonClick"
          style="-fx-font-size: 15;" text=" Get Report">
    <graphic>
      <FontIcon iconColor="#ffffff" iconLiteral="fas-file-download" iconSize="15" />
    </graphic>
  </Button>
</VBox>
