<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.nasaproject.Controladores.funtions.comentariosController"
            prefHeight="650" prefWidth="1066" alignment="CENTER">
    <Label text="Comments from Today's APOD" style="-fx-font-size: 30"/>

  <AnchorPane>
      <VBox alignment="CENTER" spacing="10" minWidth="1066" >
          <TextArea fx:id="comentariosTextArea" editable="false" layoutX="30.0" layoutY="21.0" maxHeight="165.0" maxWidth="500" />

          <HBox alignment="CENTER">
              <TextField fx:id="Comentario" layoutX="30.0" layoutY="192.0" prefHeight="44.0" prefWidth="312.0" />
              <Button layoutX="359.0" layoutY="192.0" onAction="#save" prefHeight="44.0" prefWidth="71.0" text="Enviar" />
          </HBox>
      </VBox>
      <HBox alignment="CENTER" spacing="20" layoutY="294.0" minWidth="1066" >
          <Button onAction="#onReloadButtonClick" styleClass="btn, btn-success" text="Reload"/>
          <Button fx:id="btnDelete" onAction="#onDeleteButtonClick" styleClass="btn, btn-danger" text="Delete" visible="false"/>
      </HBox>

      <TableView fx:id="tblComentarios" layoutX="54.0" layoutY="327.0" prefHeight="150.0" prefWidth="900.0">
          <columns>
              <TableColumn fx:id="tblColIdCliente" text="IDCOMENTARIO" minWidth="100">
                  <cellValueFactory>
                      <PropertyValueFactory property="idComentario" />
                  </cellValueFactory>
              </TableColumn>

              <TableColumn fx:id="tblColNombre" text="EMAIL">
                  <cellValueFactory>
                      <PropertyValueFactory property="email" />
                  </cellValueFactory>
              </TableColumn>

              <TableColumn fx:id="tblColTelefono" text="FECHA DE COMENTARIO" minWidth="200">
                  <cellValueFactory>
                      <PropertyValueFactory property="fechaComentario" />
                  </cellValueFactory>
              </TableColumn>

              <TableColumn fx:id="tblColRFC" text="COMENTARIO" minWidth="300">
                  <cellValueFactory>
                      <PropertyValueFactory property="comentario" />
                  </cellValueFactory>
              </TableColumn>
              <TableColumn fx:id="tblColGenero" text="FECHA">
                  <cellValueFactory>
                      <PropertyValueFactory property="fecha" />
                  </cellValueFactory>
              </TableColumn>

          </columns>
      </TableView>
  </AnchorPane>

</VBox>
