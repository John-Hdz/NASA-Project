<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      minWidth="1066" minHeight="650" alignment="CENTER" spacing="10" style="-fx-background-color: #1a1a1c">

    <Label text="USER DATA" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <HBox alignment="CENTER" spacing="20">
           <VBox>
               <Label text="User Key:" style="-fx-font-size: 18"/>
               <TextField fx:id="cveUsuarioField" style="-fx-background-color: #333; -fx-text-fill: white;"
                          minWidth="300" minHeight="30" editable="false" disable="true"/>
           </VBox>
            <VBox>
                <Label text="Email:" style="-fx-font-size: 18"/>
                <TextField fx:id="emailField" style="-fx-background-color: #333; -fx-text-fill: white;"
                           minWidth="300" minHeight="30"/>
            </VBox>

        </HBox>

        <HBox alignment="CENTER" spacing="20">

            <VBox>
                <Label text="First Name:" style="-fx-font-size: 18"/>
                <TextField fx:id="nombreUsuarioField" style="-fx-background-color: #333; -fx-text-fill: white;"
                           minWidth="300" minHeight="30"/>
            </VBox>
            <VBox>
                <Label text="Last Name:" style="-fx-font-size: 18"/>
                <TextField fx:id="apellidosField" style="-fx-background-color: #333; -fx-text-fill: white;"
                           minWidth="300" minHeight="30"/>
            </VBox>
        </HBox>
    <HBox alignment="CENTER" spacing="20">

        <VBox>
            <Label text="Birthdate:" style="-fx-font-size: 18"/>
            <TextField fx:id="fechaNacField" style="-fx-background-color: #333; -fx-text-fill: white;"
                       minWidth="300" minHeight="30"/>
        </VBox>
        <VBox >
            <Label text="Nationality:" style="-fx-font-size: 18"/>
            <TextField fx:id="nacionalidadField" style="-fx-background-color: #333; -fx-text-fill: white;"
                       minWidth="300" minHeight="30"/>
        </VBox>
    </HBox>
    <HBox alignment="CENTER" spacing="20">

        <VBox>
            <Label text="UserName" style="-fx-font-size: 18"/>
            <TextField fx:id="usernameField" style="-fx-background-color: #333; -fx-text-fill: white;"
                       minWidth="300" minHeight="30"/>
        </VBox>
        <VBox >
            <Label text="New Password" style="-fx-font-size: 18"/>
            <TextField fx:id="PasswordField" style="-fx-background-color: #333; -fx-text-fill: white;"
                       minWidth="300" minHeight="30"/>
        </VBox>
    </HBox>

    <Label/>
        <Button fx:id="updateButton" minWidth="300" minHeight="30">
            <graphic>
                <FontIcon iconLiteral="fas-user-edit" iconSize="20" iconColor="#ffffff"/>
            </graphic>
        </Button>


</VBox>
